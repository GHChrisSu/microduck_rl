<mujoco model="microduck_object_approach">
    <!--
        Vision-following lesson scene. Start with DUCK_SIM_KEYFRAME=HOME.
        The target is a full-scale 1.73 m human, animated by body_server.
    -->
    <include file="robot_groundcontact.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Full-scale 1.73 m person. Mocap parts animate without adding joints to the duck. -->
        <body name="follow_person" mocap="true" pos="6.5 0 0">
            <geom name="person_torso" type="ellipsoid" pos="0 0 1.18"
                size="0.23 0.17 0.31" rgba="0.10 0.30 0.72 1" contype="0" conaffinity="0" />
            <geom name="person_waist" type="ellipsoid" pos="0 0 0.91"
                size="0.18 0.145 0.15" rgba="0.10 0.25 0.57 1" contype="0" conaffinity="0" />
        </body>
        <body name="follow_person_head" mocap="true" pos="6.5 1.04 0">
            <geom name="person_neck" type="capsule" fromto="0 0 1.43 0 0 1.52"
                size="0.065" rgba="0.72 0.46 0.31 1" contype="0" conaffinity="0" />
            <geom name="person_head" type="sphere" pos="0 0 1.62" size="0.115"
                rgba="0.78 0.54 0.38 1" contype="0" conaffinity="0" />
            <geom name="person_nose" type="sphere" pos="-0.105 0 1.62" size="0.03"
                rgba="0.78 0.54 0.38 1" contype="0" conaffinity="0" />
        </body>

        <!-- Animated legs; the shoes follow the lower legs. -->
        <body name="follow_person_left_thigh" mocap="true" pos="6.5 0.925 0.70">
            <geom type="capsule" fromto="0 0 -0.22 0 0 0.22" size="0.075"
                rgba="0.12 0.16 0.23 1" contype="0" conaffinity="0" />
        </body>
        <body name="follow_person_left_calf" mocap="true" pos="6.5 0.925 0.285">
            <geom type="capsule" fromto="0 0 -0.22 0 0 0.22" size="0.065"
                rgba="0.12 0.16 0.23 1" contype="0" conaffinity="0" />
            <geom type="ellipsoid" pos="-0.035 0 -0.23" size="0.14 0.085 0.055"
                rgba="0.08 0.08 0.09 1" contype="0" conaffinity="0" />
        </body>
        <body name="follow_person_right_thigh" mocap="true" pos="6.5 1.155 0.70">
            <geom type="capsule" fromto="0 0 -0.22 0 0 0.22" size="0.075"
                rgba="0.12 0.16 0.23 1" contype="0" conaffinity="0" />
        </body>
        <body name="follow_person_right_calf" mocap="true" pos="6.5 1.155 0.285">
            <geom type="capsule" fromto="0 0 -0.22 0 0 0.22" size="0.065"
                rgba="0.12 0.16 0.23 1" contype="0" conaffinity="0" />
            <geom type="ellipsoid" pos="-0.035 0 -0.23" size="0.14 0.085 0.055"
                rgba="0.08 0.08 0.09 1" contype="0" conaffinity="0" />
        </body>

        <!-- Separate upper arms and forearms swing opposite to the legs. -->
        <body name="follow_person_left_upper_arm" mocap="true" pos="6.5 0.85 1.23">
            <geom type="capsule" fromto="0 0 -0.17 0 0 0.17" size="0.06"
                rgba="0.10 0.30 0.72 1" contype="0" conaffinity="0" />
        </body>
        <body name="follow_person_left_forearm" mocap="true" pos="6.5 0.84 0.96">
            <geom type="capsule" fromto="0 0 -0.16 0 0 0.16" size="0.052"
                rgba="0.10 0.30 0.72 1" contype="0" conaffinity="0" />
        </body>
        <body name="follow_person_right_upper_arm" mocap="true" pos="6.5 1.23 1.23">
            <geom type="capsule" fromto="0 0 -0.17 0 0 0.17" size="0.06"
                rgba="0.10 0.30 0.72 1" contype="0" conaffinity="0" />
        </body>
        <body name="follow_person_right_forearm" mocap="true" pos="6.5 1.24 0.96">
            <geom type="capsule" fromto="0 0 -0.16 0 0 0.16" size="0.052"
                rgba="0.10 0.30 0.72 1" contype="0" conaffinity="0" />
        </body>
    </worldbody>
</mujoco>
